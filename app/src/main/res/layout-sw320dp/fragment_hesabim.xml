<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        tools:context=".ui.fragment.HesabimFragment">

        <!-- Sayfa Başlığı -->
        <TextView
            android:id="@+id/textViewSayfaBaslik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hesabım"
            android:textColor="@color/favTitleColor"
            android:textSize="21sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Profil Kartı -->
        <androidx.cardview.widget.CardView
            android:id="@+id/profileCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/textViewSayfaBaslik"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/background"
                android:padding="16dp">

                <!-- Profil Resmi -->
                <ImageView
                    android:id="@+id/imageViewProfil"
                    android:layout_width="73dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="32dp"
                    android:clipToOutline="true"
                    android:contentDescription="Profil Resmi"
                    android:scaleType="centerCrop"
                    android:src="@drawable/yumico_logo_img"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Satır: İsim -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowIsim"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toEndOf="@id/imageViewProfil"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/textViewIsimLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="İsim:"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:id="@+id/textViewIsim"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=" Ecem"
                        android:textColor="@color/textColor"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="@id/textViewIsimLabel"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/textViewIsimLabel"
                        app:layout_constraintTop_toTopOf="@id/textViewIsimLabel" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Satır: Soyisim -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowSoyisim"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toEndOf="@id/imageViewProfil"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rowIsim">

                    <TextView
                        android:id="@+id/textViewSoyisimLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Soyisim:"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:id="@+id/textViewSoyisim"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=" Akkavak"
                        android:textColor="@color/textColor"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="@id/textViewSoyisimLabel"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/textViewSoyisimLabel"
                        app:layout_constraintTop_toTopOf="@id/textViewSoyisimLabel" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Satır: Email -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toEndOf="@id/imageViewProfil"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rowSoyisim">

                    <TextView
                        android:id="@+id/textViewEmailLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email:"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:id="@+id/textViewEmail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=" ecem@gmail.com"
                        android:textColor="@color/textColor"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="@id/textViewEmailLabel"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/textViewEmailLabel"
                        app:layout_constraintTop_toTopOf="@id/textViewEmailLabel" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Satır: Adres -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowAdres"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toEndOf="@id/imageViewProfil"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rowEmail">

                    <TextView
                        android:id="@+id/textViewAdresLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adres:"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:id="@+id/textViewAdres"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:breakStrategy="simple"
                        android:ellipsize="none"
                        android:lineSpacingExtra="2dp"
                        android:scrollHorizontally="false"
                        android:text="Örnek Mah. No:123, Şehir/Ülke,  Çok Uzun Adres Denemesi"
                        android:textAlignment="viewStart"
                        android:textColor="@color/textColor"
                        android:textSize="16sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/textViewAdresLabel"
                        app:layout_constraintTop_toTopOf="@id/textViewAdresLabel" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Satır: Telefon -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowTelefon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toEndOf="@id/imageViewProfil"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rowAdres">

                    <TextView
                        android:id="@+id/textViewTelefonLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Telefon:"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:id="@+id/textViewTelefon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=" 05054327654"
                        android:textColor="@color/textColor"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="@id/textViewTelefonLabel"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/textViewTelefonLabel"
                        app:layout_constraintTop_toTopOf="@id/textViewTelefonLabel" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>



        <!-- Signout Container -->
        <FrameLayout
            android:id="@+id/signoutFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            app:layout_constraintTop_toBottomOf="@id/profileCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Geri Butonu -->
        <ImageButton
            android:id="@+id/buttonCloseKullanici"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Geri"
            android:padding="8dp"
            android:src="@drawable/back_img"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
